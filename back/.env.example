# Backend environment for Smart Greenhouse

# MongoDB connection (primary store)
DATA_BASE_UTL=mongodb+srv://USER:PASS@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=serre

# Neon/Postgres connection (secondary store for mirroring)
# Prefer NEON_DATABASE_URL; falls back to POSTGRES_URL or DATABASE_URL
# Include sslmode=require when using Neon
NEON_DATABASE_URL=postgres://USER:PASS@YOUR-NEON-HOST/YOUR_DB?sslmode=require

# JWT configuration
JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=7d

# Frontend URL for CORS (optional dev-defaults already allowed)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# Seed user (used by scripts/seed_data.js)
SEED_USER_NOM=Admin
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=admin123